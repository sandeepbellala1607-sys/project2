# ==============================================================================
# SMART EXPENSE TRACKER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Duplicate this file to .env or .env.production for custom environment settings.
# NOTE: In client-side applications, only non-sensitive public variables should
# be prefixed with VITE_. Never expose private API keys or database credentials!

# Canonical production URL of your custom domain
VITE_APP_URL=https://myexpensetracker.com

# Alternative www subdomain (for canonical redirect verification)
VITE_APP_URL_WWW=https://www.myexpensetracker.com

# Application Metadata
VITE_APP_NAME=Smart Expense Tracker
VITE_APP_CURRENCY=INR
VITE_APP_LOCALE=en-IN
VITE_APP_ENV=production
